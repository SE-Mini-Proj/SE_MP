# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=*

# Security & JWT Configuration
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_EXPIRES_IN=24h

# Transport Security / TLS Configuration (Issue #6, CHAT-SR-001)
ENFORCE_TLS=false
HSTS_MAX_AGE=31536000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration (Pub/Sub & Presence Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
