# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=*

# Security & JWT Configuration
JWT_SECRET=supersecretjwtkey_change_in_production
# JWT expiry is capped at 24 hours; use a positive duration such as 15m or 24h.
JWT_EXPIRES_IN=24h

# Transport Security / TLS Configuration (Issue #6, CHAT-SR-001)
ENFORCE_TLS=false
HSTS_MAX_AGE=31536000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration (Pub/Sub & Presence Cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Media uploads (S3-compatible object storage, e.g. AWS S3 or MinIO)
MAX_UPLOAD_SIZE_BYTES=10485760
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
# Set true for MinIO and other path-style S3-compatible endpoints.
OBJECT_STORAGE_FORCE_PATH_STYLE=false
