{
  "name": "realtime-chat-app",
  "version": "1.0.0",
  "description": "Real-Time Chat Application built with Node.js, Express, and Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/services.test.js --runInBand",
    "test:integration": "jest tests/db.test.js tests/health.test.js tests/socket.test.js --runInBand",
    "test:load": "artillery run tests/performance/http-load.yml && artillery run tests/performance/socket-load.yml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "node -e \"console.log('Build verification complete')\"",
    "db:migrate": "node src/db/migrate.js up",
    "db:migrate:down": "node src/db/migrate.js down",
    "db:seed": "node src/db/seed.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SE-Mini-Proj/SE_MP.git"
  },
  "keywords": [
    "chat",
    "websocket",
    "socket.io",
    "express",
    "realtime"
  ],
  "author": "Pranay Shah, Nikhil Mahabala Shekar, Prarthana Herur, Nikhil B Menon",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SE-Mini-Proj/SE_MP/issues"
  },
  "homepage": "https://github.com/SE-Mini-Proj/SE_MP#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "artillery": "^2.0.25",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
